pipeline {
    agent any

    stages {

        stage('Git Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/gsharma1298/django-notes-app.git'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t my:${BUILD_NUMBER} .'
            }
        }

        stage('Trivy Scan') {
            steps {
                sh '''
                    trivy image \
                      --severity HIGH,CRITICAL \
                      --exit-code 1 \
                      my:${BUILD_NUMBER}
                '''
            }
        }
    }

    post {
        always {
            echo 'Pipeline completed.'
        }
    }
}

























